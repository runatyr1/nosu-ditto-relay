# Application configuration
PORT="13131"
RELAY_URL="wss://relay.example.com/"
NOSTR_NSEC=""

# HTTP header carrying the real client IP when running behind a reverse
# proxy (e.g. "CF-Connecting-IP" behind Cloudflare, "X-Real-IP" or
# "X-Forwarded-For" behind nginx; first entry is used for comma-separated
# values). Leave unset for direct deployments to use the socket address.
# Only set a header your proxy strips/overwrites, or clients can spoof it.
# IP_HEADER="CF-Connecting-IP"

# Log level: debug | info | warn | error (default: info).
# Logs are one-line JSON (queryable in Loki with `| json`). `debug` includes
# per-REQ/per-EVENT/per-connection traffic entries; `info` and above are
# infrequent lifecycle, warning, and error entries only.
# LOG_LEVEL="info"

# OpenSearch configuration
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_INDEX="nostr-events"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# History configuration (replaceable/addressable event versioning)
# HISTORY_ENABLED="true"
# HISTORY_KINDS_WHITELIST=""
# HISTORY_KINDS_EXCLUDED="30382,30383,30384,30385"

# Auth-protected kinds: require AUTH for REQ/COUNT, excluded from unscoped queries
# AUTH_KINDS="4,1059"

# Subset of AUTH_KINDS served WITHOUT authentication to filters that name a
# non-empty `authors` list (when every auth kind in the filter is exempt).
# Gift wraps (1059) are authored by unguessable ephemeral/derived pubkeys, so
# knowing the author to ask for is itself the read capability; #p-scoped and
# unscoped queries stay auth-gated.
# AUTH_AUTHOR_EXEMPT_KINDS="1059"

# Master pubkeys: comma-separated hex pubkeys. A connection that
# authenticates (NIP-42) as any of these has unconditional read access to all
# auth-protected kinds (DMs, gift wraps, ...) for every user, bypassing all AUTH
# rules. Intended for operator-controlled services (bridges, notifications).
# MASTER_PUBKEYS=""

# Web-of-trust seed pubkeys: comma-separated hex pubkeys. Expanded 2
# follow-hops via kind 3 contact lists in the local index; only pubkeys in
# the resulting set count toward engagement scores (sort:hot/top/etc) and
# trends, which stops sybil swarms from farming them. Use real accounts
# with meaningful follow graphs (e.g. the operator's personal account) —
# NOT the MASTER_PUBKEYS service keys. Unset = no trust filtering.
# WOT_SEED_PUBKEYS=""

# Maximum inbound WebSocket message size in bytes (enforced AND advertised via NIP-11)
# RELAY_MAX_MESSAGE_LENGTH="4000000"

# Maximum number of entries in any single filter array (ids/authors/kinds/#tag)
# RELAY_MAX_FILTER_VALUES="20000"

# Maximum number of events returned per REQ filter (enforced AND advertised via
# NIP-11 max_limit). Clients supplying a larger `limit` are clamped to this.
# RELAY_MAX_LIMIT="1000"

# Default number of events returned per REQ filter when `limit` is omitted.
# Must not exceed RELAY_MAX_LIMIT.
# RELAY_DEFAULT_LIMIT="100"

# Maximum number of values indexed per tag name in tags_map (e.g. number of
# p-tags in a kind-3 contact list projected into tags_map.p). Default 5000
# matches NIP-11 max_event_tags so any compliant event is fully indexable.
# RELAY_TAG_VALUE_MAX_COUNT_PER_NAME="5000"

# Protocol worker threads. Each protocol worker owns its connections'
# complete protocol state and does all per-message work (parse, validate,
# verify/analyze inline, query, frame building); the main thread only routes
# strings between sockets and workers, and a single indexer worker owns all
# OpenSearch writes. Unset = auto: max(1, min(16, floor(cores / 4))).
# Must be >= 1 when set.
# PROTOCOL_WORKERS=""

# Backpressure cap. When the OpenSearch bulk queue is exceeded, EVENT
# messages are NACK'd with `OK false "error: relay overloaded"` so upstream
# clients (e.g. bridges) back off naturally instead of holding the
# connection while we OOM.
# BULK_MAX_QUEUE="5000"

# Per-connection cap on concurrent handleEvent Promises. EVENT messages
# over the cap wait their turn via a per-connection semaphore. Prevents
# one firehose client (e.g. a Bluesky bridge) from flooding its protocol
# worker's microtask queue and starving REQs from other connections.
# RELAY_MAX_INFLIGHT_PER_CONN="32"

# Banned hashtags. Comma-separated, case-insensitive. Events containing any
# matching `t` tag are rejected at ingestion with
# `OK false "blocked: event contains a banned hashtag"`. Default: none.
# BANNED_HASHTAGS="spam,nsfw,scam"

# Rejected event kinds. Comma-separated. Events matching any of these kinds
# are rejected at ingestion with
# `OK false "blocked: kind <n> is not accepted by this relay"` and never
# stored. Default: signed artifacts that are never meant to be published to a
# relay as standalone events — 13 (NIP-59 seal), 9734 (NIP-57 zap request),
# 20013 (Concord encrypted seal), 20014 (Concord plaintext seal), 22242 (NIP-42
# client auth), 24242 (Blossom blob auth), 27235 (NIP-98 HTTP auth). Note:
# NWC (23194/23195), Nostr Connect (24133), zap receipts (9735), and gift
# wraps (1059) ARE meant to be relayed and are not rejected. Set to an empty
# string to accept all kinds.
# REJECTED_KINDS="13,9734,20013,20014,22242,24242,27235"

# Maximum number of records a single NIP-77 NEG-OPEN sync may cover.
# Queries matching more records are rejected with `NEG-ERR blocked:`.
# Each record costs ~40 bytes of session memory while the sync is open.
# RELAY_NEGENTROPY_MAX_RECORDS="1000000"
